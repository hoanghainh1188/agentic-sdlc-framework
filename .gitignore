.DS_Store
node_modules/
*.tmp
dist/
coverage/
*.tsbuildinfo

# Local environment files with real values (platform/deploy/scripts/init-env.sh). Only *.env.example is committed.
.env
*.env
!*.env.example
# OpenBao TLS certificates made by platform/deploy/openbao/tls.sh dev (A10): never committed.
openbao-tls/
# The trial stack's OpenBao key shares, encrypted with the person's passphrase (V08, pnpm trial:up): never committed.
trial-openbao-keys.age
.trial-openbao-keys.age.*
# `pnpm server:setup` progress (D-08 V16): step names only, no secret, but local to the machine.
server-setup-progress.json
server-setup-progress.json.tmp
# `pnpm alerts` state (D-08 O03): check IDs, statuses and times, no secret, but local to the machine.
alerts-state.json
# The team access proxy's certificates made by platform/deploy/access/tls.sh dev (V09): never committed.
access-tls/

# Dashboard smoke test output (U01): screenshots go to the PR, not the repository.
platform/tests/e2e/screenshots/
platform/tests/e2e/test-results/

# The images.lock of a release, downloaded once by platform/deploy/scripts/images.sh (V15, ADR-M94 §2.4).
platform/deploy/.images/

# The npm package build of the CLI (V05): made by pnpm cli:pack, never committed.
platform/apps/cli/npm-dist/
