{
  "name": "agentic-sdlc-framework",
  "version": "0.7.0",
  "private": true,
  "license": "MIT",
  "description": "Agentic SDLC Framework: handbook + platform monorepo",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @sdlc/dashboard build",
    "typecheck": "tsc -b && tsc -p platform/tests/tsconfig.json && tsc -p platform/tests/e2e/tsconfig.json && tsc -p platform/spikes/openhands/tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "clean": "tsc -b --clean",
    "test:compose": "SDLC_COMPOSE_IT=1 vitest run --config vitest.integration.config.ts platform/tests/integration/deploy",
    "trial:up": "pnpm build && node platform/deploy/trial/dist/main.js up",
    "trial:start": "tsc -b platform/deploy/trial && node platform/deploy/trial/dist/main.js start",
    "trial:down": "tsc -b platform/deploy/trial && node platform/deploy/trial/dist/main.js down",
    "doctor": "tsc -b platform/deploy/doctor && node platform/deploy/doctor/dist/main.js",
    "github-app:create": "tsc -b platform/deploy/github-app && node platform/deploy/github-app/dist/main.js",
    "test:trial-up": "pnpm build && SDLC_TRIAL_UP_TEST=1 vitest run --config vitest.integration.config.ts platform/tests/integration/deploy/trial-up.test.ts",
    "test:upgrade": "pnpm build && SDLC_UPGRADE_TEST=1 vitest run --config vitest.integration.config.ts platform/tests/integration/deploy/upgrade.test.ts",
    "test:fresh-deploy": "pnpm build && SDLC_FRESH_DEPLOY_TEST=1 vitest run --config vitest.integration.config.ts platform/tests/integration/deploy/fresh-deploy.test.ts",
    "test:seaweedfs": "SDLC_COMPOSE_IT=1 vitest run --config vitest.integration.config.ts platform/tests/integration/deploy/seaweedfs-access.test.ts",
    "test:db": "platform/deploy/scripts/test-db.sh",
    "test:knowledge": "platform/deploy/scripts/test-knowledge.sh",
    "test:workflow": "tsc -b platform/apps/worker && SDLC_WORKFLOW_TEST=1 SDLC_TEMPORAL_TEST_SERVER=\"$(platform/deploy/scripts/temporal-test-server.sh)\" SDLC_TEST_DB_DIR=platform/tests/integration/workflow platform/deploy/scripts/test-db.sh",
    "test:workflow-compose": "tsc -b platform/apps/worker && SDLC_WORKFLOW_COMPOSE_TEST=1 SDLC_TEST_DB_DIR=platform/tests/integration/workflow/compose-smoke.test.ts platform/deploy/scripts/test-db.sh",
    "test:openbao": "SDLC_OPENBAO_TEST=1 vitest run --config vitest.integration.config.ts platform/tests/integration/openbao",
    "test:backup": "SDLC_BACKUP_TEST=1 vitest run --config vitest.integration.config.ts platform/tests/integration/backup",
    "test:litellm": "SDLC_LITELLM_TEST=1 vitest run --config vitest.integration.config.ts platform/tests/integration/litellm",
    "test:observability": "SDLC_OBSERVABILITY_TEST=1 vitest run --config vitest.integration.config.ts platform/tests/integration/observability",
    "test:api": "SDLC_API_TEST=1 vitest run --config vitest.integration.config.ts platform/tests/integration/api",
    "test:access": "SDLC_ACCESS_TEST=1 vitest run --config vitest.integration.config.ts platform/tests/integration/deploy/access.test.ts",
    "test:runner": "SDLC_RUNNER_TEST=1 SDLC_TEST_DB_DIR=platform/tests/integration/runner platform/deploy/scripts/test-db.sh",
    "test:runner-split": "tsc -b platform/deploy/doctor && SDLC_RUNNER_SPLIT_TEST=1 vitest run --config vitest.integration.config.ts platform/tests/integration/runner/split-live.test.ts",
    "test:runner-compose": "SDLC_RUNNER_COMPOSE_TEST=1 vitest run --config vitest.integration.config.ts platform/tests/integration/runner/compose-live.test.ts",
    "test:sandbox-image": "SDLC_SANDBOX_IMAGE_TEST=1 vitest run --config vitest.integration.config.ts platform/tests/integration/sandbox-image",
    "test:sandbox-live": "SDLC_TEST_DB_DIR=platform/tests/integration/sandbox-image/pilot-live.test.ts platform/deploy/scripts/test-db.sh",
    "test:proposal-pilot": "SDLC_PROPOSAL_PILOT_TEST=1 SDLC_TEST_DB_DIR=platform/tests/integration/sandbox-image/proposal-pilot.test.ts platform/deploy/scripts/test-db.sh",
    "test:agent": "SDLC_AGENT_TEST=1 SDLC_TEST_DB_DIR=platform/tests/integration/agent platform/deploy/scripts/test-db.sh",
    "test:pilot": "tsc -b platform/apps/worker && SDLC_PILOT_TEST=1 SDLC_TEMPORAL_TEST_SERVER=\"$(platform/deploy/scripts/temporal-test-server.sh)\" SDLC_TEST_DB_DIR=platform/tests/integration/pilot platform/deploy/scripts/test-db.sh --no-file-parallelism",
    "test:pilot-live": "tsc -b platform/apps/worker && SDLC_TEMPORAL_TEST_SERVER=\"$(platform/deploy/scripts/temporal-test-server.sh)\" SDLC_TEST_DB_DIR=platform/tests/integration/pilot/pilot-live.test.ts platform/deploy/scripts/test-db.sh",
    "test:agent-real": "SDLC_AGENT_REAL_TEST=1 SDLC_TEST_DB_DIR=platform/tests/integration/agent/agent-real.test.ts platform/deploy/scripts/test-db.sh",
    "eval": "tsc -b platform/eval && platform/eval/run.sh",
    "eval:report": "tsc -b platform/eval && node platform/eval/dist/cli.js report",
    "eval:pairs": "tsc -b platform/eval && node platform/eval/dist/cli.js pairs",
    "test:eval-server": "SDLC_EVAL_SERVER_TEST=1 SDLC_TEST_DB_DIR=platform/tests/integration/eval/eval-server.test.ts platform/deploy/scripts/test-db.sh",
    "test:eval-score": "SDLC_EVAL_SCORE_TEST=1 vitest run --config vitest.integration.config.ts platform/tests/integration/eval/score-server.test.ts",
    "test:attack": "SDLC_ATTACK_TEST=1 SDLC_TEST_DB_DIR=platform/tests/integration/attack platform/deploy/scripts/test-db.sh",
    "test:agent-api": "SDLC_AGENT_API_TEST=1 SDLC_TEST_DB_DIR=platform/tests/integration/agent/agent-api.test.ts platform/deploy/scripts/test-db.sh",
    "openbao:bootstrap": "platform/deploy/openbao/bootstrap.sh",
    "openbao:tls": "platform/deploy/openbao/tls.sh",
    "access:tls": "platform/deploy/access/tls.sh",
    "backup": "platform/deploy/backup/backup.sh",
    "restore": "platform/deploy/backup/restore.sh",
    "db:migrate": "tsc -b platform/packages/core && node platform/packages/core/dist/db/migrate-cli.js latest",
    "db:status": "tsc -b platform/packages/core && node platform/packages/core/dist/db/migrate-cli.js status",
    "sdlc": "tsc -b platform/apps/cli && node platform/apps/cli/dist/main.js",
    "api:start": "tsc -b platform/apps/api && node platform/apps/api/dist/main.js",
    "worker:start": "tsc -b platform/apps/worker && node platform/apps/worker/dist/main.js",
    "compose:env": "platform/deploy/scripts/init-env.sh",
    "compose:core": "platform/deploy/scripts/up.sh core",
    "compose:obs": "platform/deploy/scripts/up.sh core observability",
    "compose:models": "platform/deploy/scripts/up.sh core models",
    "compose:platform": "platform/deploy/scripts/up.sh core platform",
    "compose:sandbox": "platform/deploy/scripts/up.sh core sandbox",
    "compose:access": "platform/deploy/scripts/up.sh core platform access",
    "compose:knowledge": "platform/deploy/scripts/up.sh core knowledge",
    "compose:models-local": "platform/deploy/scripts/up.sh core models models-local",
    "compose:runner-link": "platform/deploy/scripts/up.sh core models platform runner-link",
    "runner-host:env": "platform/deploy/scripts/runner-host.sh env",
    "runner-host:up": "platform/deploy/scripts/runner-host.sh up",
    "runner-host:down": "platform/deploy/scripts/runner-host.sh down",
    "models-local:pull": "docker compose -f platform/deploy/docker-compose.yml --env-file platform/deploy/.env --profile models-local-pull run --rm vllm-pull",
    "sandbox-image:build": "platform/sandbox-images/build.sh",
    "tool-image:build": "platform/deploy/scripts/tool-image.sh",
    "images": "platform/deploy/scripts/images.sh",
    "diagrams:render": "python3 scripts/diagrams.py render",
    "diagrams:check": "python3 scripts/diagrams.py check",
    "compose:down": "docker compose -f platform/deploy/docker-compose.yml --env-file platform/deploy/.env --profile core --profile observability --profile models --profile platform --profile sandbox --profile access --profile knowledge --profile models-local down",
    "test:dashboard": "pnpm build && playwright test --config platform/tests/e2e/playwright.config.ts",
    "cli:pack": "tsc -b platform/apps/cli && node platform/tools/cli-package/build.mjs",
    "cli:pack-check": "pnpm cli:pack && node platform/tools/cli-package/check.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@eslint/js": "10.0.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@playwright/test": "1.63.0",
    "@sdlc/adapter-agent-openhands": "workspace:*",
    "@sdlc/adapter-agent-opencode": "workspace:*",
    "@sdlc/adapter-evidence-s3": "workspace:*",
    "@sdlc/adapter-git-github": "workspace:*",
    "@sdlc/adapter-knowledge-pgvector": "workspace:*",
    "@sdlc/adapter-model-litellm": "workspace:*",
    "@sdlc/adapter-policy-simple": "workspace:*",
    "@sdlc/adapter-traces-langfuse": "workspace:*",
    "@sdlc/agent-kit": "workspace:*",
    "@sdlc/api-schemas": "workspace:*",
    "@sdlc/cli": "workspace:*",
    "@sdlc/config": "workspace:*",
    "@sdlc/contracts": "workspace:*",
    "@sdlc/eval": "workspace:*",
    "@sdlc/messages": "workspace:*",
    "@sdlc/secrets": "workspace:*",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/testing": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "age-encryption": "0.3.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "kysely": "0.29.6",
    "pg": "8.23.0",
    "prettier": "3.9.9",
    "rolldown": "1.2.11",
    "rxjs": "7.8.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.1",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
