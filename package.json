{
  "name": "agentic-sdlc-framework",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Agentic SDLC Framework: handbook + platform monorepo",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p platform/tests/tsconfig.json && tsc -p platform/spikes/openhands/tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "clean": "tsc -b --clean",
    "test:compose": "SDLC_COMPOSE_IT=1 vitest run --config vitest.integration.config.ts platform/tests/integration/deploy",
    "test:db": "platform/deploy/scripts/test-db.sh",
    "test:workflow": "tsc -b platform/apps/worker && SDLC_WORKFLOW_TEST=1 SDLC_TEMPORAL_TEST_SERVER=\"$(platform/deploy/scripts/temporal-test-server.sh)\" SDLC_TEST_DB_DIR=platform/tests/integration/workflow platform/deploy/scripts/test-db.sh",
    "test:workflow-compose": "tsc -b platform/apps/worker && SDLC_WORKFLOW_COMPOSE_TEST=1 SDLC_TEST_DB_DIR=platform/tests/integration/workflow/compose-smoke.test.ts platform/deploy/scripts/test-db.sh",
    "test:openbao": "SDLC_OPENBAO_TEST=1 vitest run --config vitest.integration.config.ts platform/tests/integration/openbao",
    "test:litellm": "SDLC_LITELLM_TEST=1 vitest run --config vitest.integration.config.ts platform/tests/integration/litellm",
    "test:api": "SDLC_API_TEST=1 vitest run --config vitest.integration.config.ts platform/tests/integration/api",
    "test:runner": "SDLC_RUNNER_TEST=1 SDLC_TEST_DB_DIR=platform/tests/integration/runner platform/deploy/scripts/test-db.sh",
    "test:runner-compose": "SDLC_RUNNER_COMPOSE_TEST=1 vitest run --config vitest.integration.config.ts platform/tests/integration/runner/compose-live.test.ts",
    "test:sandbox-image": "SDLC_SANDBOX_IMAGE_TEST=1 vitest run --config vitest.integration.config.ts platform/tests/integration/sandbox-image",
    "test:sandbox-live": "SDLC_TEST_DB_DIR=platform/tests/integration/sandbox-image/pilot-live.test.ts platform/deploy/scripts/test-db.sh",
    "test:agent": "SDLC_AGENT_TEST=1 SDLC_TEST_DB_DIR=platform/tests/integration/agent platform/deploy/scripts/test-db.sh",
    "test:agent-real": "SDLC_AGENT_REAL_TEST=1 SDLC_TEST_DB_DIR=platform/tests/integration/agent/agent-real.test.ts platform/deploy/scripts/test-db.sh",
    "openbao:bootstrap": "platform/deploy/openbao/bootstrap.sh",
    "db:migrate": "tsc -b platform/packages/core && node platform/packages/core/dist/db/migrate-cli.js latest",
    "db:status": "tsc -b platform/packages/core && node platform/packages/core/dist/db/migrate-cli.js status",
    "sdlc": "tsc -b platform/apps/cli && node platform/apps/cli/dist/main.js",
    "api:start": "tsc -b platform/apps/api && node platform/apps/api/dist/main.js",
    "worker:start": "tsc -b platform/apps/worker && node platform/apps/worker/dist/main.js",
    "compose:env": "platform/deploy/scripts/init-env.sh",
    "compose:core": "platform/deploy/scripts/up.sh core",
    "compose:obs": "platform/deploy/scripts/up.sh core observability",
    "compose:models": "platform/deploy/scripts/up.sh core models",
    "compose:platform": "platform/deploy/scripts/up.sh core platform",
    "compose:sandbox": "platform/deploy/scripts/up.sh core sandbox",
    "sandbox-image:build": "platform/sandbox-images/build.sh",
    "compose:down": "docker compose -f platform/deploy/docker-compose.yml --env-file platform/deploy/.env --profile core --profile observability --profile models --profile platform --profile sandbox down"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@eslint/js": "10.0.1",
    "@sdlc/adapter-agent-openhands": "workspace:*",
    "@sdlc/adapter-evidence-s3": "workspace:*",
    "@sdlc/adapter-git-github": "workspace:*",
    "@sdlc/adapter-model-litellm": "workspace:*",
    "@sdlc/adapter-policy-simple": "workspace:*",
    "@sdlc/config": "workspace:*",
    "@sdlc/contracts": "workspace:*",
    "@sdlc/messages": "workspace:*",
    "@sdlc/secrets": "workspace:*",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/testing": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "kysely": "0.29.6",
    "pg": "8.23.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.1",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
