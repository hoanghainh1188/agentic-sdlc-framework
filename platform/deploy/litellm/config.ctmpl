{{- /*
  LiteLLM configuration with keys, rendered by the OpenBao Agent sidecar (agent.hcl) into
  tmpfs (task C03, design/ADR-M24). Compose profile "models"; the server always runs with it.

  - Model provider keys: kv/litellm/providers/<provider>, field api_key. A model appears only
    when its provider has a key, so a missing key never blocks start-up.
  - Master key: kv/cost-controller/litellm-master-key, field value (one source, shared with the
    Cost Controller). Salt key: kv/litellm/salt-key, field value. Both are required.
  - Values go through toJSON, so no key can break the YAML.
  - Every model declares model_info.provider_type (api or self_hosted, D-07 section 4). A
    self-hosted model must declare an internal cost per token above 0: with cost 0, LiteLLM
    skips budget checks (D-07 section 3).
  - Adding a model: add an entry below inside "if in $providers ...", then restart LiteLLM.
  - Tracing (A08, design/ADR-M35 §2.4): when the sidecar has SDLC_OTEL_ENDPOINT (up.sh sets it with
    the profile observability), LiteLLM's langfuse_otel callback sends one span per model call to
    the OpenTelemetry Collector, which forwards it to Langfuse v4. LiteLLM holds no Langfuse key.
    The run's labels reach the trace from the virtual key's metadata and tags (ADR-M24 §2.2).
*/ -}}
{{- $providers := secrets "kv/metadata/litellm/providers/" }}
model_list:
{{- if in $providers "anthropic" }}
{{- with secret "kv/data/litellm/providers/anthropic" }}
  # Small current Claude model (ADR-M10 section 3). Prices from LiteLLM's built-in price list.
  # The gateway name carries the model version (QUESTIONS #93): the agent register's `model_ref`.
  - model_name: claude-haiku-4-5-20251001
    litellm_params:
      model: anthropic/claude-haiku-4-5-20251001
      api_key: {{ .Data.data.api_key | toJSON }}
    model_info:
      provider_type: api
{{- end }}
{{- end }}

{{- if in $providers "ollama" }}
{{- with secret "kv/data/litellm/providers/ollama" }}
  # DEVELOPER MACHINES ONLY (QUESTIONS #78, ADR-M10 section 3): a local Ollama model, used for the
  # C05 real-model run. Never on the internal server (no GPU). Ollama has no key: the entry holds
  # its address as LiteLLM sees it (field api_base, for example http://host.docker.internal:11434).
  # Local tag only: Ollama ":cloud" models send data to ollama.com and are not self-hosted.
  # Internal cost above 0 so budgets still apply (D-07 section 3); [Proposal] placeholder values
  # until the GPU cost per token is known.
  - model_name: gpt-oss-20b
    litellm_params:
      model: ollama_chat/gpt-oss:20b
      api_base: {{ .Data.data.api_base | toJSON }}
      num_ctx: 32768
      reasoning_effort: low
      input_cost_per_token: 0.0000001
      output_cost_per_token: 0.0000004
    model_info:
      provider_type: self_hosted
{{- end }}
{{- end }}
general_settings:
{{- with secret "kv/data/cost-controller/litellm-master-key" }}
  master_key: {{ .Data.data.value | toJSON }}
{{- end }}
  database_url: os.environ/DATABASE_URL

environment_variables:
{{- with secret "kv/data/litellm/salt-key" }}
  LITELLM_SALT_KEY: {{ .Data.data.value | toJSON }}
{{- end }}
{{- with env "SDLC_OTEL_ENDPOINT" }}
  # Read before the callbacks are set up. LiteLLM adds /v1/traces.
  OTEL_EXPORTER: otlp_http
  OTEL_ENDPOINT: {{ . | toJSON }}
  OTEL_SERVICE_NAME: sdlc-litellm
{{- end }}
{{- with env "SDLC_OTEL_ENDPOINT" }}

litellm_settings:
  callbacks: ["langfuse_otel"]
{{- end }}

# Same as config.yaml: Valkey keys must expire (noeviction, design/ADR-M17 section 2.4).
router_settings:
  redis_host: os.environ/REDIS_HOST
  redis_port: os.environ/REDIS_PORT
  redis_password: os.environ/REDIS_PASSWORD
