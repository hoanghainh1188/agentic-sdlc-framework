# Environment for platform/deploy/docker-compose.yml (task A02).
#
# Do NOT copy this file by hand. Run:
#   platform/deploy/scripts/init-env.sh
# It writes platform/deploy/.env (mode 600) with a random value for every CHANGEME.
# .env is ignored by Git. Never commit real values.
#
# CHANGEME values are placeholders only; Compose refuses to start while a secret is missing.

# --- General --------------------------------------------------------------
COMPOSE_PROJECT_NAME=sdlc
# Host address for published ports. Keep 127.0.0.1: the server accepts no inbound
# internet connections (D-03 section 9).
SDLC_BIND_ADDR=127.0.0.1

# --- Host ports -------------------------------------------------------------
POSTGRES_HOST_PORT=5432
TEMPORAL_HOST_PORT=7233
TEMPORAL_UI_HOST_PORT=8080
LITELLM_HOST_PORT=4000
SEAWEEDFS_S3_HOST_PORT=8333
OPENBAO_HOST_PORT=8200
LANGFUSE_HOST_PORT=3000

# --- PostgreSQL (one database and one owner role per component) -----------------
POSTGRES_SUPERUSER_PASSWORD=CHANGEME
PLATFORM_DB_PASSWORD=CHANGEME
TEMPORAL_DB_PASSWORD=CHANGEME
LITELLM_DB_PASSWORD=CHANGEME
LANGFUSE_DB_PASSWORD=CHANGEME

# --- Temporal ------------------------------------------------------------------
TEMPORAL_NAMESPACE=default
# Retention of CLOSED workflows in Temporal. Unrelated to audit retention (platform DB).
TEMPORAL_NAMESPACE_RETENTION=30d

# --- Valkey (shared by LiteLLM and Langfuse) ------------------------------------
VALKEY_PASSWORD=CHANGEME
# Hard memory limit. Policy is noeviction: when full, writes fail for both
# Langfuse and LiteLLM (design/ADR-M17). Watch usage; raise if needed.
VALKEY_MAXMEMORY=256mb

# --- LiteLLM -------------------------------------------------------------------
# Must start with "sk-". Moves to OpenBao KV after task A03 (D-03 section 8.2).
LITELLM_MASTER_KEY=CHANGEME
# Encrypts credentials stored in the LiteLLM database. Never change it after first start.
LITELLM_SALT_KEY=CHANGEME

# --- SeaweedFS (S3 API) --------------------------------------------------------
SEAWEEDFS_S3_ACCESS_KEY=CHANGEME
SEAWEEDFS_S3_SECRET_KEY=CHANGEME
SEAWEEDFS_VOLUME_SIZE_LIMIT_MB=1024

# --- Observability profile: ClickHouse + Langfuse -------------------------------
CLICKHOUSE_PASSWORD=CHANGEME
LANGFUSE_URL=http://localhost:3000
LANGFUSE_NEXTAUTH_SECRET=CHANGEME
LANGFUSE_SALT=CHANGEME
# 64 hex characters (openssl rand -hex 32).
LANGFUSE_ENCRYPTION_KEY=CHANGEME
# Headless initialisation: the only Langfuse account (open sign-up is disabled).
LANGFUSE_INIT_ORG_ID=sdlc
LANGFUSE_INIT_ORG_NAME="Agentic SDLC"
LANGFUSE_INIT_PROJECT_ID=sdlc-platform
LANGFUSE_INIT_PROJECT_NAME="Agentic SDLC platform"
# Must start with "pk-lf-" and "sk-lf-".
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=CHANGEME
LANGFUSE_INIT_PROJECT_SECRET_KEY=CHANGEME
LANGFUSE_INIT_USER_EMAIL=admin@sdlc.invalid
LANGFUSE_INIT_USER_NAME="Platform admin"
LANGFUSE_INIT_USER_PASSWORD=CHANGEME
