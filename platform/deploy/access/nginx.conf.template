# Team access: the TLS reverse proxy in front of sdlc-api (V09, design/ADR-M67).
#
# The image's entrypoint fills in ${SDLC_ACCESS_*} (and only those: NGINX_ENVSUBST_FILTER) and
# writes the result to /etc/nginx/conf.d, inside the http block of the image's nginx.conf.
# Static test: platform/tests/deploy/access-static.test.ts. Live test: pnpm test:access.
#
# Rules (ADR-M67 §2.2-§2.5):
#   - One TLS listener (8443). No plain listener: plain HTTP on the TLS port answers 400.
#   - Only the routes below; everything else answers 404.
#   - Never set or remove a Content-Security-Policy: the api's CSP passes through unchanged.
#   - X-Forwarded-For is always overwritten with the TCP peer; the api trusts it from us only.
#   - Logs hold no header and no query string (the token travels in Authorization only).

server_tokens off;

# Per client address (ADR-M67 §2.4). Over a limit: 429.
limit_req_zone $binary_remote_addr zone=sdlc_api:10m rate=${SDLC_ACCESS_RATE_PER_SECOND}r/s;
limit_req_zone $binary_remote_addr zone=sdlc_auth:10m rate=${SDLC_ACCESS_SIGNIN_RATE_PER_MINUTE}r/m;
limit_conn_zone $binary_remote_addr zone=sdlc_conn:10m;
limit_req_status 429;
limit_conn_status 429;

# The path without its query string: $uri. Never $request, $args or a header.
log_format sdlc_access escape=json
  '{"time":"$time_iso8601","client":"$remote_addr","method":"$request_method",'
  '"path":"$uri","status":$status,"bytes":$body_bytes_sent,"duration":$request_time}';

# Request limits (ADR-M67 §2.4). The body limit equals the api's (BODY_LIMIT_BYTES, 64 KiB).
client_max_body_size 64k;
client_header_timeout 10s;
client_body_timeout 10s;
send_timeout 30s;
large_client_header_buffers 4 8k;

# TLS 1.2 and 1.3 only (Mozilla "intermediate").
ssl_protocols TLSv1.2 TLSv1.3;
ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
ssl_prefer_server_ciphers off;
ssl_session_tickets off;
ssl_session_cache shared:sdlc_tls:5m;
ssl_session_timeout 1h;
ssl_certificate /etc/nginx/tls/server.pem;
ssl_certificate_key /etc/nginx/tls/server-key.pem;

# Docker's DNS: the api's address is looked up again when it changes (a recreated container).
resolver 127.0.0.11 valid=10s ipv6=off;

# Any Host that is not ours: 421 (also stops DNS rebinding).
server {
  listen 8443 ssl default_server;
  server_name _;
  access_log /dev/stdout sdlc_access;
  error_page 497 = @plain_http;
  location / {
    return 421;
  }
  location @plain_http {
    default_type text/plain;
    return 400 "Use https:// for this address.\n";
  }
}

server {
  listen 8443 ssl;
  server_name ${SDLC_ACCESS_SERVER_NAMES};
  # Here, not at http level: the image's nginx.conf sets it there already.
  keepalive_timeout 30s;
  access_log /dev/stdout sdlc_access;

  # Plain HTTP sent to the TLS port (nginx 497): refused, never redirected (ADR-M67 §2.2).
  error_page 497 = @plain_http;

  limit_conn sdlc_conn ${SDLC_ACCESS_CONN_PER_ADDR};

  # Response headers (ADR-M67 §2.4). Only here, never in a location: a location with its own
  # add_header would drop these. The api's copies of the same names are hidden below, so each
  # appears once. No Content-Security-Policy here: the api's passes through.
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

  # To the api (ADR-M67 §2.5): the client address overwritten, never appended. A variable, so the
  # resolver above is used; without a URI part the request's own path is passed on.
  set $sdlc_api http://sdlc-api:8080;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header Connection "";
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header Forwarded "";
  proxy_set_header X-Forwarded-Proto "";
  proxy_set_header X-Forwarded-Host "";
  proxy_set_header X-Real-IP "";
  proxy_hide_header Strict-Transport-Security;
  proxy_hide_header X-Content-Type-Options;
  proxy_hide_header X-Frame-Options;
  proxy_hide_header Referrer-Policy;
  proxy_hide_header Permissions-Policy;
  proxy_hide_header X-Powered-By;
  proxy_connect_timeout 5s;
  proxy_read_timeout 120s;
  proxy_send_timeout 30s;
  proxy_buffering on;

  # The route allow-list (ADR-M67 §2.3).
  location = / {
    return 308 /dashboard/;
  }
  location /dashboard/ {
    limit_req zone=sdlc_api burst=${SDLC_ACCESS_RATE_BURST} nodelay;
    proxy_pass $sdlc_api;
  }
  location /v1/auth/ {
    limit_req zone=sdlc_auth burst=${SDLC_ACCESS_SIGNIN_BURST} nodelay;
    proxy_pass $sdlc_api;
  }
  location /v1/ {
    limit_req zone=sdlc_api burst=${SDLC_ACCESS_RATE_BURST} nodelay;
    proxy_pass $sdlc_api;
  }
  location = /health/live {
    limit_req zone=sdlc_api burst=${SDLC_ACCESS_RATE_BURST} nodelay;
    proxy_pass $sdlc_api;
  }
  # Status only, no data: `sdlc doctor` calls it (V07, cli.api_ready).
  location = /health/ready {
    limit_req zone=sdlc_api burst=${SDLC_ACCESS_RATE_BURST} nodelay;
    proxy_pass $sdlc_api;
  }
  location / {
    return 404;
  }
  location @plain_http {
    default_type text/plain;
    return 400 "Use https:// for this address.\n";
  }
}

# The container's health check only: 127.0.0.1 inside the container, never published.
server {
  listen 127.0.0.1:8081;
  access_log off;
  location = /healthz {
    default_type text/plain;
    return 200 "ok\n";
  }
  location / {
    return 404;
  }
}
