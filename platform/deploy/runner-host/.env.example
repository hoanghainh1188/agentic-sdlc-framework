# Environment for platform/deploy/runner-host/docker-compose.yml: the runner on its own Docker
# Engine (task O01, design/ADR-M91). Create it on the runner host with:
#   pnpm runner-host:env
# It holds no secret: the runner's credentials go into a volume (openbao:bootstrap
# runner-credentials with SDLC_RUNNER_DOCKER_HOST on the platform host).

# The same project name as the platform's .env: the runner's instance label and the relays'
# container names (<project>-litellm-1) depend on it.
COMPOSE_PROJECT_NAME=sdlc
# The platform host's link address: its WireGuard address (a separate VM) or the host address that
# only the two Engines use (the same server). Required.
SDLC_RUNNER_LINK_ADDR=
# The Docker socket of the runner's own Engine. Rootless: /run/user/<uid of sdlc-runner>/docker.sock
SDLC_DOCKER_SOCKET=/var/run/docker.sock
# Group of that socket inside the Engine. Rootless: 0 (the Engine's user is root of its namespace).
SDLC_DOCKER_GID=0
# OpenBao's CA certificate (ca.pem of SDLC_OPENBAO_TLS_DIR on the platform host; public, no key),
# copied to the runner host.
SDLC_OPENBAO_CA_FILE=/etc/sdlc/openbao-ca.pem
# The same as in the platform's .env.
SDLC_RUNNER_MAX_SANDBOXES=1
SDLC_RUNNER_MAX_EVAL_SANDBOXES=1
TEMPORAL_NAMESPACE=default
