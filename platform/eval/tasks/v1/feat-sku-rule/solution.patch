+/** SKU format: three capital letters, a hyphen and three digits (T02). */
+const SKU_FORMAT = /^[A-Z]{3}-[0-9]{3}$/;
+
+/** True when the SKU, without spaces at both ends, has the format `AAA-999`. */
+export function isValidSku(sku: string): boolean {
+  return SKU_FORMAT.test(sku.trim());
+}
