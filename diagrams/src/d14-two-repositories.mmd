%%{init: {"flowchart": {"wrappingWidth": 320}}}%%
flowchart LR
    T["Team<br/>sdlc CLI · /approve comments · dashboard"]
    subgraph R1["Repo 1: agentic-sdlc-framework (the platform: a tool)"]
        direction TB
        P1["platform/ · handbook/ · design/"]
